# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicit text classifications (common in this repo)
*.sh      text eol=lf
*.bash    text eol=lf
*.py      text eol=lf
*.c       text eol=lf
*.h       text eol=lf
*.cpp     text eol=lf
*.hpp     text eol=lf
*.cxx     text eol=lf
*.hxx     text eol=lf
*.cmake   text eol=lf
CMakeLists.txt text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.dox     text eol=lf
*.in      text eol=lf

